# =========================================================
# Frontend (Next.js)
# =========================================================
# Base URL of the Spring Boot backend
NEXT_PUBLIC_API_URL=http://localhost:8080

# =========================================================
# Backend (Spring Boot) — set these in your shell or .env
# =========================================================
# PostgreSQL credentials
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT signing secret — MUST be at least 32 bytes (256 bits) for HS256
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-64-character-secret-string

# Google Gemini API key (https://aistudio.google.com/apikey)
# Required for RAG vector search and Gemini chat generation.
# Without a valid key the app still runs — RAG falls back to lexical search.
GOOGLE_API_KEY=

# Google Cloud project id / location used by the Spring AI GenAI client.
# Required (non-empty) by Spring AI 2.0.1 GenAI auto-configuration even in
# API-key mode. Placeholders are fine with the public Gemini API.
GOOGLE_PROJECT_ID=controlplane-demo
GOOGLE_LOCATION=global